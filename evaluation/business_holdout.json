    {
      "case_id": "holdout-basic-channel-sales-7d",
      "category": "basic_analysis",
      "question": "近一周各平台成交金额排行",
      "access_role": "analyst",
      "expected_outcome": "succeeded",
      "expected_plan": {
        "analysis_goal": "统计近7天各渠道销售额",
        "metrics": [
          "sales_amount"
        ],
        "dimensions": [
          "channel"
        ],
        "filters": [],
        "time_range": {
          "days": 7
        },
        "sort": [
          {
            "field": "sales_amount",
            "direction": "descending"
          }
        ],
        "limit": 100
      },
      "expected_source_ids": [
        "metric.sales_amount.v1",
        "schema.orders",
        "schema.order_items",
        "schema.join.orders.order_items"
      ],
      "gold_sql": "SELECT o.channel AS channel,\n       SUM(oi.quantity * oi.unit_price) AS sales_amount\nFROM orders AS o\nJOIN order_items AS oi ON oi.order_id = o.order_id\nWHERE o.status = 'paid'\n  AND o.created_at >= %(start_time)s\n  AND o.created_at < %(end_time)s\nGROUP BY o.channel\nORDER BY sales_amount DESC, channel ASC\nLIMIT 10",
      "expected_rows": [
        {
          "channel": "淘宝",
          "sales_amount": "9000.00"
        },
        {
          "channel": "京东",
          "sales_amount": "800.00"
        }
      ],
      "expected_chart_type": "bar",
      "expected_reason_code": null,
      "expected_sensitive_columns": [],
      "fault": null,
      "rationale": "未见表达用于验证7天渠道销售泛化。",
      "tags": [
        "sales",
        "channel",
        "holdout"
      ]
    },
