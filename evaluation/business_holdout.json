          "days": 30
        },
        "sort": [],
        "limit": 100
      },
      "expected_source_ids": [
        "metric.average_order_value.v1",
        "schema.orders"
      ],
      "gold_sql": "SELECT ROUND(\n    COALESCE(SUM(o.amount) / NULLIF(COUNT(DISTINCT o.order_id), 0), 0),\n    2\n) AS average_order_value\nFROM orders AS o\nWHERE o.status = 'paid'\n  AND o.created_at >= %(start_time)s\n  AND o.created_at < %(end_time)s",
